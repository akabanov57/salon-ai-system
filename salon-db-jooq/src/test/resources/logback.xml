<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <!-- Standard clean console output configuration -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <!-- FIX: Added [%X{traceId:-SYSTEM}] to track the contextual request lifecycle -->
      <pattern>%d{HH:mm:ss.SSS} [%thread] [%X{traceId:-SYSTEM}] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Root level logs are throttled to WARN to prevent third-party framework spam -->
  <root level="WARN">
    <appender-ref ref="CONSOLE" />
  </root>

  <!-- Elevate our custom application layer messages to INFO -->
  <logger name="salon" level="INFO" />

  <!-- Elevate our business service database adapters to DEBUG to log transaction steps -->
  <logger name="salon.db.jooq.service" level="DEBUG" />

  <!-- Optional: Uncomment this line if you want to see raw SQL executions generated by jOOQ -->
  <!-- <logger name="org.jooq.tools.LoggerListener" level="DEBUG" /> -->

</configuration>
