<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <!-- 1. Оригинальный консольный аппендер (оставляем как есть) -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <!-- FIX: Added [%X{traceId:-SYSTEM}] to track the contextual request lifecycle -->
      <pattern>%d{HH:mm:ss.SSS} [%thread] [%X{traceId:-SYSTEM}] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- 2. Асинхронная обертка для CONSOLE -->
  <appender name="ASYNC_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
    <!-- Ссылаемся на наш консольный вывод -->
    <appender-ref ref="CONSOLE" />

    <!-- Настройки для предотвращения потери логов DEBUG от jOOQ/DB -->
    <queueSize>1024</queueSize>             <!-- Увеличили буфер, так как SQL-логи идут пачками -->
    <discardingThreshold>0</discardingThreshold> <!-- НЕ удалять логи DEBUG/INFO при заполнении очереди -->
    <neverBlock>false</neverBlock>          <!-- Если очередь переполнится, приложение притормозит, -->
    <!-- но гарантированно запишет все шаги транзакций -->
    <includeCallerData>false</includeCallerData> <!-- Отключаем тяжелый сбор номеров строк кода -->
  </appender>

  <!-- 3. Корневой логгер теперь направляем в АСИНХРОННЫЙ аппендер -->
  <root level="WARN">
    <appender-ref ref="ASYNC_CONSOLE" /> <!-- Изменено на ASYNC_CONSOLE -->
  </root>

  <!-- Elevate our custom application layer messages to INFO -->
  <logger name="salon" level="INFO" />

  <!-- Elevate our business service database adapters to DEBUG to log transaction steps -->
  <logger name="salon.db.jooq.service" level="DEBUG" />

  <!-- Optional: Uncomment this line if you want to see raw SQL executions generated by jOOQ -->
  <!-- <logger name="org.jooq.tools.LoggerListener" level="DEBUG" /> -->

</configuration>
